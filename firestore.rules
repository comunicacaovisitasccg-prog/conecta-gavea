rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /carrossel/{fotoId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /visitas/{visitaId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['vagas08Ocupadas', 'vagas10Ocupadas']);

      match /inscricoes/{inscricaoId} {
        allow create: if request.auth != null;
        allow read: if request.auth != null &&
          (request.auth.uid == resource.data.uid);
        allow update: if request.auth != null &&
          request.auth.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cancelada', 'removidoDaPlanilha', 'confirmadoPresenca', 'statusConfirmacaoSincronizada']);
        allow delete: if false;
      }
    }

    match /{caminho=**}/inscricoes/{inscricaoId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}