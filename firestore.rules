rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do usuário: só o próprio usuário lê/edita o seu
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Fotos do carrossel: leitura pública para usuários logados, escrita só pelo painel/admin (via console)
    match /carrossel/{fotoId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Configurações gerais do app (ex: número do selo "visitantes já participaram")
    match /configuracoes/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Visitas: leitura para logados; escrita de campos de vagas só via transação de inscrição
    match /visitas/{visitaId} {
      allow read: if request.auth != null;
      allow create, delete: if false; // criadas manualmente ou por sincronização (fase 2)
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['vagas08Ocupadas', 'vagas10Ocupadas']);

      match /inscricoes/{inscricaoId} {
        allow create: if request.auth != null;
        allow read: if request.auth != null &&
          (request.auth.uid == resource.data.uid);
        // a própria pessoa pode cancelar ou confirmar presença na sua inscrição,
        // sem poder alterar nenhum outro campo (nome, cpf, etc.)
        allow update: if request.auth != null &&
          request.auth.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cancelada', 'removidoDaPlanilha', 'confirmadoPresenca', 'statusConfirmacaoSincronizada']);
        allow delete: if false;
      }
    }

    // Permite a busca "todas as minhas inscrições" (Minhas Inscrições), que consulta
    // a coleção inscricoes em todas as visitas de uma vez — precisa de um curinga recursivo
    match /{caminho=**}/inscricoes/{inscricaoId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
